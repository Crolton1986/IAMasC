<!--
  .NET libraries IAMasC loads at runtime. Nothing builds this project: tools/Restore-NuGetPackage.ps1
  reads it, downloads each package from nuget.org, checks the Sha512 below, and extracts the
  assemblies into lib/. It's a .csproj so GitHub's dependency graph, Dependabot, dependency review,
  and Trivy can see these packages.

  When bumping a version, update Sha512 too. Get it from NuGet's catalog (packageHash, base64)
  or with: (Get-FileHash -Algorithm SHA512 <package>.nupkg).Hash.ToLowerInvariant()
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
