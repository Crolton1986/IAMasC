{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iamasc.dev/schemas/v1/server.schema.json",
  "title": "IAMasC server settings",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "iamasc.dev/v1"
    },
    "kind": {
      "const": "Server"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "match": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    }
                  ]
                }
              },
              "admins": {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "group"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "match"
            ],
            "oneOf": [
              {
                "required": [
                  "repo"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ]
          }
        },
        "sharedModules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "namespace"
            ]
          }
        },
        "unmatched": {
          "enum": [
            "hold"
          ]
        },
        "git": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object"
            },
            "signCommits": {
              "type": "boolean"
            },
            "author": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "email"
              ]
            }
          },
          "additionalProperties": false
        },
        "registry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "index": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "index"
            ]
          }
        },
        "auth": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "dev",
                "entra"
              ]
            }
          },
          "additionalProperties": false
        },
        "listen": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "dataPath": {
          "type": "string",
          "minLength": 1,
          "description": "Folder for the database and logs. Relative paths are resolved from the settings file."
        }
      },
      "additionalProperties": false,
      "required": [
        "workspaces",
        "auth"
      ]
    }
  },
  "additionalProperties": false
}
