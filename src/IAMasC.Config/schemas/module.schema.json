{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iamasc.dev/schemas/v1/module.schema.json",
  "title": "IAMasC module",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "iamasc.dev/v1"
    },
    "kind": {
      "const": "Module"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "default": {},
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "type"
            ]
          }
        },
        "grants": {
          "type": "object",
          "description": "Grants per provider. Provider schemas validate the inside in a later release.",
          "additionalProperties": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "grants"
      ]
    }
  },
  "additionalProperties": false
}
